# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/achieve_doubts

# Authentication (Better-Auth)
BETTER_AUTH_SECRET=development_secret_must_be_32_characters_long_min
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Server
PORT=3000
NODE_ENV=development

# App-Check / Attestation
ATTESTATION_SECRET=dev_attestation_secret_placeholder

# S3 / Cloudflare R2 (Optional for local development)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=doubts-media
S3_PUBLIC_URL=http://localhost:3000/uploads
