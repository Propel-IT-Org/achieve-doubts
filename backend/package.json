{
  "name": "@achieve/doubts-backend",
  "exports": {
    ".": {
      "default": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./permissions": {
      "default": "./src/lib/permissions.ts",
      "types": "./src/lib/permissions.ts"
    },
    "./schemas": {
      "default": "./src/schemas.ts",
      "types": "./src/schemas.ts"
    },
    "./errors": {
      "default": "./src/lib/errors.ts",
      "types": "./src/lib/errors.ts"
    }
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist --sourcemap=linked --minify-syntax --minify-whitespace",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/main.ts seed",
    "auth:generate": "better-auth generate --config ./src/lib/auth.ts --output ./src/db/schema/auth.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@hono/zod-validator": "^0.9.1",
    "@inferdi/hono": "^6.1.0",
    "@inferdi/inferdi": "^6.1.0",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "postgres": "^3.4.9",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  }
}
