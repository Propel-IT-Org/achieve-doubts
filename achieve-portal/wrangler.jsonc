{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // A stand-in for Achieve, for testing the student SSO handshake end to end.
  // The static site in public/ plays Achieve's student dashboard; the worker
  // plays Achieve's backend, calling the Doubts API with the shared secret.
  "name": "achieve-portal",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-17",
  // Requests that match a file are served from public/; everything else
  // (POST /doubt-solve) reaches the worker.
  "assets": { "directory": "./public" },
  "observability": { "enabled": true },
  // A deploy would otherwise replace the dashboard's variables with whatever
  // this file lists — which is how DOUBTS_API_URL got reset to localhost.
  "keep_vars": true,
  // Settings live in the dashboard (Settings > Variables and Secrets), and in
  // `.dev.vars` for `bun run dev`:
  //   DOUBTS_API_URL         the Doubts backend's origin, which must match
  //                          its BETTER_AUTH_URL (a plain variable)
  //   ACHIEVE_SHARED_SECRET  the backend's ACHIEVE_SHARED_SECRET (secret)
  //   PORTAL_ACCESS_CODE     required to use this portal at all (secret)
}
